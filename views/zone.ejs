<%- include('partials/header') %>
<main id="main-content" style="max-width: 1000px; margin: 40px auto; padding: 0 20px;">
    <a href="/" style="color: var(--accent-cyan); text-decoration: none; font-weight: bold;">← Back to Zones</a>
    <h1 style="font-size: 3rem; margin: 20px 0; color: var(--accent-cyan);"><%= zone.name %></h1>
    <img src="<%= zone.image_url %>" alt="Exotic wildlife inside <%= zone.name %>" style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 30px;">
    
    <div style="background-color: var(--bg-card); padding: 30px; border-radius: 8px; margin-bottom: 40px;">
        <h2>Our Conservation Objective</h2>
        <p><%= zone.conservation_focus %></p>
    </div>

    <h2>Exhibits & Interactive Experiences</h2>
    <div style="margin-top: 20px;">
        <% exhibits.forEach(exhibit => { %>
            <div style="background-color: var(--bg-card); padding: 20px; border-radius: 6px; margin-bottom: 20px; border-left: 4px solid var(--alert-gold);">
                <h3><%= exhibit.title %></h3>
                <p style="margin: 10px 0;"><%= exhibit.description %></p>
                <p style="font-size: 0.9rem; color: var(--accent-cyan);"><strong>Interactive Activity:</strong> <%= exhibit.interactive_element %></p>
            </div>
        <% }); %>
    </div>
</main>
<%- include('partials/footer') %>
